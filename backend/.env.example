# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Storage Directories
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES=2147483648

# Video Processing Binaries
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
PYTHON_PATH="python"

# AI Planner (Google Gemini API - Free Tier)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_VISION_ENABLED=false
WHISPER_MODEL="tiny"

# Stock Media Providers (Free Tier: Pexels & Pixabay)
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Background Job Worker
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MS=600000
