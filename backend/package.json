{
  "name": "studio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/index.ts",
    "generate-previews": "tsx src/scripts/generate-previews.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:pipeline": "vitest run tests/pipeline.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/scripts/smoke-test.ts",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/uuid": "^10.0.0",
    "oxlint": "^1.89.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "vitest": "^3.0.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
